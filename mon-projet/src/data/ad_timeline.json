 "lines": [
  {
   "s": 0.06,
   "e": 2.365,
   "text": "Tes DMs débordent… et ton agenda reste vide?"
  },
  {
   "s": 2.574,
   "e": 5.907,
   "text": "Avec EzSet, l'IA répond à tous tes DMs et qualifie tes leads, toute seule."
  },
  {
   "s": 6.059,
   "e": 7.912,
   "text": "Toi, tu fais juste les calls."
  },
  {
   "s": 8.12,
   "e": 13.05,
   "text": "Besoin d'aide? Ajoute tes setters: ils voient toutes tes conversations Instagram, Messenger et WhatsApp."
  },
  {
   "s": 13.329,
   "e": 16.86,
   "text": "L'IA leur souffle quoi répondre. Ils corrigent un message, et elle apprend."
  },
  {
   "s": 17.108,
   "e": 18.333,
   "text": "EzSet. Crée ton compte."
  }
 ],
